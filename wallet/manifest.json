{
  "name": "Wallet",
  "appDomain": "wallet.app.provable.dev",
  "icon": "logo.png",
  "description": "Minimal Ethereum and Solana wallet for PrivacySafe apps.",
  "version": "0.1.0",
  "components": {
    "/index.html": {
      "runtime": "web-gui",
      "startedBy": "user",
      "formFactor": [
        "desktop",
        "tablet",
        "phone"
      ],
      "capsRequested": {
        "appRPC": [
          "WalletInternal"
        ],
        "shell": {
          "clipboard": "writeonly",
          "fsResource": {
            "otherApps": {
              "launcher.app.privacysafe.io": "ui-settings"
            }
          },
          "openURL": [
            {
              "schema": "https",
              "domain": "etherscan.io"
            },
            {
              "schema": "https",
              "domain": "explorer.solana.com"
            }
          ],
          "openDashboard": true
        },
        "storage": {
          "appFS": "default"
        },
        "connectToExternal": {
          "fetch": [
            {
              "schema": "https",
              "domain": "ethereum-rpc.publicnode.com"
            },
            {
              "schema": "https",
              "domain": "eth.llamarpc.com"
            },
            {
              "schema": "https",
              "domain": "ethereum.drpc.org"
            },
            {
              "schema": "https",
              "domain": "rpc.flashbots.net"
            },
            {
              "schema": "https",
              "domain": "sepolia.drpc.org"
            },
            {
              "schema": "https",
              "domain": "api.mainnet-beta.solana.com"
            },
            {
              "schema": "https",
              "domain": "solana-rpc.publicnode.com"
            },
            {
              "schema": "https",
              "domain": "api.devnet.solana.com"
            }
          ]
        },
        "logToPlatform": true
      },
      "windowOpts": {
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640
      }
    },
    "/walletDenoServices.js": {
      "runtime": "deno",
      "services": {
        "WalletInternal": {
          "thisAppComponents": "*"
        },
        "WalletSigner": {
          "thisAppComponents": "*",
          "otherApps": "*"
        }
      },
      "capsRequested": {
        "storage": {
          "appFS": "default"
        },
        "connectToExternal": {
          "fetch": [
            {
              "schema": "https",
              "domain": "ethereum-rpc.publicnode.com"
            },
            {
              "schema": "https",
              "domain": "eth.llamarpc.com"
            },
            {
              "schema": "https",
              "domain": "ethereum.drpc.org"
            },
            {
              "schema": "https",
              "domain": "rpc.flashbots.net"
            },
            {
              "schema": "https",
              "domain": "sepolia.drpc.org"
            },
            {
              "schema": "https",
              "domain": "api.mainnet-beta.solana.com"
            },
            {
              "schema": "https",
              "domain": "solana-rpc.publicnode.com"
            },
            {
              "schema": "https",
              "domain": "api.devnet.solana.com"
            }
          ]
        },
        "logToPlatform": true
      }
    }
  },
  "launchers": [
    {
      "name": "Wallet",
      "icon": "logo.png",
      "description": "Minimal Ethereum and Solana wallet for PrivacySafe apps.",
      "component": "/index.html",
      "formFactor": [
        "desktop",
        "tablet",
        "phone"
      ]
    }
  ],
  "launchOnSystemStartup": [
    {
      "name": "Wallet signer service",
      "component": "/walletDenoServices.js",
      "icon": "logo.png",
      "description": "Starts the wallet signing service for PrivacySafe app requests."
    }
  ]
}
