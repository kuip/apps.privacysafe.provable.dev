{
  "name": "wallet.app.provable.dev",
  "version": "0.1.0",
  "description": "Minimal Ethereum and Solana wallet for PrivacySafe",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.deno.config.ts",
    "test": "vitest run",
    "deps:locked": "npm ci --ignore-scripts",
    "pack": "node scripts/pack-app.mjs",
    "pack:discovery": "node scripts/build-discovery-site.mjs",
    "serve": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "1.5.4",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@v1nt1248/3nclient-lib": "0.2.64",
    "bs58": "6.0.0",
    "ed25519-hd-key": "1.3.0",
    "ethers": "6.15.0",
    "tweetnacl": "1.0.3",
    "vue": "3.5.24"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.10",
    "happy-dom": "20.9.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-node-polyfills": "0.24.0",
    "vitest": "4.1.5",
    "vue-tsc": "3.1.4"
  }
}
